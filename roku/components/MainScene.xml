<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
  <script type="text/brightscript" uri="MainScene.brs" />
  <children>
    <Rectangle id="bg" width="1920" height="1080" color="0x0B1020FF" />

    <!-- sign in -->
    <Group id="login" visible="false">
      <Label translation="[160,130]" text="AerioTV VOD · Películas y series" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
      <Label translation="[160,210]" width="1560" wrap="true" font="font:SmallSystemFont" color="0xB0B8D0FF"
             text="Ingresa los datos de tu servicio: la dirección del servidor (por ejemplo http://servidor.com:8080), tu usuario y tu contraseña." />
      <LabelList id="loginList" translation="[160,320]" itemSize="[1300,76]" numRows="4" color="0xFFFFFFFF" focusedColor="0x0B1020FF" />
      <Label id="loginStatus" translation="[160,680]" width="1560" wrap="true" font="font:MediumSystemFont" color="0xFFC857FF" />
    </Group>

    <!-- catalog -->
    <Group id="home" visible="false">
      <Rectangle id="tabMark" translation="[50,32]" width="240" height="70" color="0x2563EB66" />
      <Label id="tabMovies" translation="[50,32]" width="240" height="70" horizAlign="center" vertAlign="center" text="Películas" font="font:MediumBoldSystemFont" />
      <Label id="tabSeries" translation="[310,32]" width="240" height="70" horizAlign="center" vertAlign="center" text="Series" font="font:MediumBoldSystemFont" />
      <Label id="hint" translation="[600,52]" width="1270" horizAlign="right" font="font:SmallestSystemFont" color="0x8A93AFFF"
             text="▲ Películas / Series · ✱ opciones (Ver más tarde)" />
      <LabelList id="cats" translation="[60,140]" itemSize="[470,56]" numRows="16" vertFocusAnimationStyle="floatingFocus"
                 color="0xD8DCEAFF" focusedColor="0x0B1020FF" />
      <PosterGrid id="grid" translation="[590,140]" basePosterSize="[240,360]" itemSpacing="[22,74]" numColumns="5" numRows="2"
                  caption1NumLines="1" posterDisplayMode="scaleToFit" />
      <Label id="gridStatus" translation="[590,480]" width="1280" horizAlign="center" wrap="true" font="font:MediumSystemFont" color="0x8A93AFFF" />
    </Group>

    <!-- one series -->
    <Group id="seriesView" visible="false">
      <Poster id="seriesPoster" translation="[60,50]" width="250" height="375" loadDisplayMode="scaleToFit" />
      <Label id="seriesTitle" translation="[350,60]" width="1500" wrap="true" maxLines="2" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
      <Label id="seriesPlot" translation="[350,170]" width="1500" height="230" wrap="true" font="font:SmallSystemFont" color="0xB0B8D0FF" />
      <Label translation="[350,410]" font="font:SmallestSystemFont" color="0x8A93AFFF" text="✱ agregar o quitar de Ver más tarde" />
      <LabelList id="seasons" translation="[60,470]" itemSize="[360,56]" numRows="10" color="0xD8DCEAFF" focusedColor="0x0B1020FF" />
      <LabelList id="episodes" translation="[460,470]" itemSize="[1400,56]" numRows="10" color="0xD8DCEAFF" focusedColor="0x0B1020FF" />
    </Group>

    <Video id="video" width="1920" height="1080" visible="false" enableUI="false" />

    <!-- player controls (our own: ◀ ▶ 10 s, OK pausa, ✱ audio y subtítulos) -->
    <Group id="osd" visible="false">
      <Rectangle translation="[0,800]" width="1920" height="280" color="0x000000B0" />
      <Label id="osdTitle" translation="[80,830]" width="1760" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" />
      <Label id="osdState" translation="[80,880]" width="1760" font="font:SmallSystemFont" color="0xFFC857FF" />
      <Rectangle translation="[80,950]" width="1760" height="8" color="0xFFFFFF40" />
      <Rectangle id="osdBar" translation="[80,950]" width="0" height="8" color="0xFFFFFFFF" />
      <Label id="osdTime" translation="[80,970]" width="880" font="font:SmallSystemFont" color="0xFFFFFFFF" />
      <Label id="osdLeft" translation="[960,970]" width="880" horizAlign="right" font="font:SmallSystemFont" color="0xFFFFFFFF" />
      <Label translation="[80,1020]" width="1760" font="font:SmallestSystemFont" color="0xB0B8D0FF"
             text="OK pausa · ◀ ▶ 10 s · ⏪ ⏩ 1 min · ✱ audio y subtítulos · Atrás salir" />
    </Group>

    <Rectangle id="toastBg" translation="[560,60]" width="800" height="80" color="0x000000CC" visible="false" />
    <Label id="toast" translation="[560,60]" width="800" height="80" horizAlign="center" vertAlign="center"
           font="font:SmallSystemFont" color="0xFFFFFFFF" visible="false" wrap="true" />
    <Timer id="catTimer" duration="0.35" repeat="false" />
    <Timer id="toastTimer" duration="3" repeat="false" />
    <Timer id="osdTimer" duration="1" repeat="true" />
  </children>
</component>
